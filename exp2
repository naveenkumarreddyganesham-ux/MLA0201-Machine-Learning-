        "\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# 1. Create a sample CSV file\n",
        "data = {\n",
        "    'Sky': ['Sunny', 'Sunny', 'Rainy', 'Sunny'],\n",
        "    'AirTemp': ['Warm', 'Warm', 'Cold', 'Warm'],\n",
        "    'Humidity': ['Normal', 'High', 'High', 'High'],\n",
        "    'Wind': ['Strong', 'Strong', 'Strong', 'Strong'],\n",
        "    'Water': ['Warm', 'Warm', 'Warm', 'Cool'],\n",
        "    'Forecast': ['Same', 'Same', 'Change', 'Change'],\n",
        "    'EnjoySport': ['Yes', 'Yes', 'No', 'Yes']\n",
        "}\n",
        "\n",
        "df = pd.DataFrame(data)\n",
        "df.to_csv('training_data.csv', index=False)\n",
        "\n",
        "# 2. Read the CSV file\n",
        "df = pd.read_csv('training_data.csv')\n",
        "print(\"TRAINING DATA\")\n",
        "display(df)\n",
        "\n",
        "attributes = list(df.columns[:-1])\n",
        "target = df.columns[-1]\n",
        "examples = df[attributes].values.tolist()\n",
        "labels = df[target].tolist()\n",
        "n = len(attributes)\n",
        "\n",
        "# Attribute domains\n",
        "domains = [df[a].unique().tolist() for a in attributes]\n",
        "BOTTOM = 'Ø'\n",
        "\n",
        "# 3. Helper functions\n",
        "def covers(h, x):\n",
        "    return all(h[i] == '?' or h[i] == x[i]\n",
        "               for i in range(n))\n",
        "\n",
        "def more_general(h1, h2):\n",
        "    # True if h1 is at least as general as h2\n",
        "    return all(b == BOTTOM or a == '?' or a == b\n",
        "               for a, b in zip(h1, h2))\n",
        "\n",
        "def generalize(s, x):\n",
        "    h = s.copy()\n",
        "    for i in range(n):\n",
        "        if h[i] == BOTTOM:\n",
        "            h[i] = x[i]\n",
        "        elif h[i] != x[i]:\n",
        "            h[i] = '?'\n",
        "    return h\n",
        "\n",
        "def specialize(g, x):\n",
        "    result = []\n",
        "    for i in range(n):\n",
        "        if g[i] == '?':\n",
        "            for value in domains[i]:\n",
        "                if value != x[i]:\n",
        "                    h = g.copy()\n",
        "                    h[i] = value\n",
        "                    result.append(h)\n",
        "    return result\n",
        "\n",
        "def prune_S(S):\n",
        "    return [s for s in S if not any(\n",
        "        s != other and more_general(s, other) for other in S\n",
        "    )]\n",
        "\n",
        "def prune_G(G):\n",
        "    return [g for g in G if not any(\n",
        "        g != other and more_general(other, g) for other in G\n",
        "    )]\n",
        "\n",
        "# 4. Initialize boundaries\n",
        "S = [[BOTTOM] * n]\n",
        "G = [['?'] * n]\n",
        "\n",
        "S_history = []\n",
        "G_history = []\n",
        "\n",
        "def save_history():\n",
        "    S_history.append([h.copy() for h in S])\n",
        "    G_history.append([h.copy() for h in G])\n",
        "\n",
        "save_history()\n",
        "\n",
        "# 5. Candidate-Elimination algorithm\n",
        "for i, (x, label) in enumerate(zip(examples, labels), start=1):\n",
        "    if label.lower() == 'yes':\n",
        "        # Remove general hypotheses that reject positive example\n",
        "        G = [g for g in G if covers(g, x)]\n",
        "\n",
        "        new_S = []\n",
        "        for s in S:\n",
        "            if covers(s, x):\n",
        "                new_S.append(s)\n",
        "            else:\n",
        "                h = generalize(s, x)\n",
        "                if any(more_general(g, h) for g in G):\n",
        "                    new_S.append(h)\n",
        "        S = prune_S(new_S)\n",
        "\n",
        "    else:\n",
        "        # Remove specific hypotheses that accept negative example\n",
        "        S = [s for s in S if not covers(s, x)]\n",
        "\n",
        "        new_G = []\n",
        "        for g in G:\n",
        "            if not covers(g, x):\n",
        "                new_G.append(g)\n",
        "            else:\n",
        "                for h in specialize(g, x):\n",
        "                    if any(more_general(h, s) for s in S):\n",
        "                        new_G.append(h)\n",
        "        G = prune_G(new_G)\n",
        "\n",
        "    save_history()\n",
        "    print(f\"\\nExample {i}: {x} -> {label}\")\n",
        "    print(\"S boundary:\", S)\n",
        "    print(\"G boundary:\", G)\n",
        "\n",
        "# 6. Display final boundaries\n",
        "print(\"\\nFINAL SPECIFIC BOUNDARY (S):\")\n",
        "for h in S:\n",
        "    print(h)\n",
        "\n",
        "print(\"\\nFINAL GENERAL BOUNDARY (G):\")\n",
        "for h in G:\n",
        "    print(h)\n",
        "\n",
        "# 7. Matplotlib visualization\n",
        "def format_hypothesis(h):\n",
        "    return '<' + ', '.join(h) + '>'\n",
        "\n",
        "fig, axes = plt.subplots(2, 1, figsize=(13, 8))\n",
        "\n",
        "stages = ['Initial'] + [f'Example {i}' for i in range(1, len(examples) + 1)]\n",
        "\n",
        "for stage in range(len(stages)):\n",
        "    s_text = '\\n'.join(format_hypothesis(h) for h in S_history[stage])\n",
        "    g_text = '\\n'.join(format_hypothesis(h) for h in G_history[stage])\n",
        "\n",
        "    axes[0].text(\n",
        "        stage, 0, s_text if s_text else 'Empty',\n",
        "        ha='center', va='center', fontsize=8,\n",
        "        bbox=dict(boxstyle='round', facecolor='lightblue')\n",
        "    )\n",
        "    axes[1].text(\n",
        "        stage, 0, g_text if g_text else 'Empty',\n",
        "        ha='center', va='center', fontsize=8,\n",
        "        bbox=dict(boxstyle='round', facecolor='lightyellow')\n",
        "    )\n",
        "\n",
        "for ax, title in zip(\n",
        "    axes, ['Specific Boundary (S)', 'General Boundary (G)']\n",
        "):\n",
        "    ax.set_xlim(-0.5, len(stages) - 0.5)\n",
        "    ax.set_ylim(-1, 1)\n",
        "    ax.set_xticks(range(len(stages)))\n",
        "    ax.set_xticklabels(stages, rotation=25)\n",
        "    ax.set_yticks([])\n",
        "    ax.set_title(title)\n",
        "    ax.grid(axis='x', linestyle='--', alpha=0.4)\n",
        "\n",
        "plt.suptitle('Candidate-Elimination: Boundary Updates')\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    }
  ]
