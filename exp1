      "source": [
        "\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from matplotlib.colors import ListedColormap\n",
        "\n",
        "# Step 1: Create the training dataset\n",
        "data = {\n",
        "    'Sky': ['Sunny', 'Sunny', 'Rainy', 'Sunny'],\n",
        "    'AirTemp': ['Warm', 'Warm', 'Cold', 'Warm'],\n",
        "    'Humidity': ['Normal', 'High', 'High', 'High'],\n",
        "    'Wind': ['Strong', 'Strong', 'Strong', 'Strong'],\n",
        "    'Water': ['Warm', 'Warm', 'Warm', 'Cool'],\n",
        "    'Forecast': ['Same', 'Same', 'Change', 'Same'],\n",
        "    'EnjoySport': ['Yes', 'Yes', 'No', 'Yes']\n",
        "}\n",
        "\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "print(\"TRAINING DATASET\")\n",
        "display(df)\n",
        "\n",
        "# Step 2: Initialize the most specific hypothesis\n",
        "attributes = list(df.columns[:-1])\n",
        "target = 'EnjoySport'\n",
        "hypothesis = ['0'] * len(attributes)\n",
        "\n",
        "hypothesis_history = [hypothesis.copy()]\n",
        "\n",
        "print(\"\\nFIND-S ALGORITHM\")\n",
        "print(\"Initial Hypothesis:\", hypothesis)\n",
        "\n",
        "# Step 3: Apply FIND-S\n",
        "for index, row in df.iterrows():\n",
        "    if row[target] == 'Yes':\n",
        "        print(f\"\\nTraining Example {index + 1}: Positive\")\n",
        "\n",
        "        for i, attribute in enumerate(attributes):\n",
        "            if hypothesis[i] == '0':\n",
        "                hypothesis[i] = row[attribute]\n",
        "            elif hypothesis[i] != row[attribute]:\n",
        "                hypothesis[i] = '?'\n",
        "\n",
        "        hypothesis_history.append(hypothesis.copy())\n",
        "        print(\"Updated Hypothesis:\", hypothesis)\n",
        "\n",
        "    else:\n",
        "        print(f\"\\nTraining Example {index + 1}: Negative\")\n",
        "        print(\"Hypothesis remains:\", hypothesis)\n",
        "\n",
        "# Step 4: Display final hypothesis\n",
        "print(\"\\nFINAL MOST SPECIFIC HYPOTHESIS\")\n",
        "for attribute, value in zip(attributes, hypothesis):\n",
        "    print(f\"{attribute}: {value}\")\n",
        "\n",
        "print(\"\\nFinal Hypothesis:\", hypothesis)\n",
        "\n",
        "# Step 5: Visualize hypothesis changes using Matplotlib\n",
        "labels = [f\"Initial\"]\n",
        "positive_count = 0\n",
        "\n",
        "for _, row in df.iterrows():\n",
        "    if row[target] == 'Yes':\n",
        "        positive_count += 1\n",
        "        labels.append(f\"Positive {positive_count}\")\n",
        "\n",
        "# Convert hypotheses to numeric values for plotting\n",
        "# 0 = Initial value, 1 = Specific value, 2 = Generalized (?)\n",
        "def encode(value):\n",
        "    if value == '0':\n",
        "        return 0\n",
        "    elif value == '?':\n",
        "        return 2\n",
        "    else:\n",
        "        return 1\n",
        "\n",
        "plot_data = [\n",
        "    [encode(value) for value in h]\n",
        "    for h in hypothesis_history\n",
        "]\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(10, 5))\n",
        "\n",
        "cmap = ListedColormap(['lightgray', 'skyblue', 'orange'])\n",
        "im = ax.imshow(plot_data, cmap=cmap, aspect='auto', vmin=0, vmax=2)\n",
        "\n",
        "ax.set_xticks(range(len(attributes)))\n",
        "ax.set_xticklabels(attributes, rotation=30, ha='right')\n",
        "ax.set_yticks(range(len(labels)))\n",
        "ax.set_yticklabels(labels)\n",
        "\n",
        "for i in range(len(plot_data)):\n",
        "    for j in range(len(attributes)):\n",
        "        ax.text(j, i, hypothesis_history[i][j],\n",
        "                ha='center', va='center', color='black',\n",
        "                fontsize=10, fontweight='bold')\n",
        "\n",
        "ax.set_title(\"FIND-S Algorithm: Hypothesis Updates\")\n",
        "ax.set_xlabel(\"Attributes\")\n",
        "ax.set_ylabel(\"Hypothesis Stage\")\n",
        "plt.colorbar(im, ax=ax, ticks=[0, 1, 2],\n",
        "             label=\"0 = Initial, 1 = Specific, 2 = Generalized\")\n",
        "plt.tight_layout()\n",
        "plt.show()"
