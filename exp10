      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.mixture import GaussianMixture\n",
        "\n",
        "# Sample dataset\n",
        "X = np.array([\n",
        "    [1, 2], [1.5, 1.8], [2, 2.5],\n",
        "    [3, 3.5], [3.5, 4], [4, 3.8],\n",
        "    [8, 8], [8.5, 9], [9, 8.5],\n",
        "    [10, 10], [10.5, 9.5], [9.5, 10]\n",
        "])\n",
        "\n",
        "# Implement EM using Gaussian Mixture Model\n",
        "model = GaussianMixture(\n",
        "    n_components=2, random_state=42\n",
        ")\n",
        "\n",
        "model.fit(X)\n",
        "\n",
        "# Predict clusters\n",
        "labels = model.predict(X)\n",
        "\n",
        "print(\"Cluster Labels:\")\n",
        "print(labels)\n",
        "\n",
        "print(\"\\nCluster Means:\")\n",
        "print(model.means_)\n",
        "\n",
        "print(\"\\nModel Converged:\")\n",
        "print(model.converged_)\n",
        "\n",
        "# Visualize clusters\n",
        "plt.scatter(\n",
        "    X[:, 0], X[:, 1],\n",
        "    c=labels, cmap=\"viridis\", s=80\n",
        ")\n",
        "\n",
        "plt.scatter(\n",
        "    model.means_[:, 0],\n",
        "    model.means_[:, 1],\n",
        "    color=\"red\", marker=\"X\",\n",
        "    s=200, label=\"Cluster Centers\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Feature 1\")\n",
        "plt.ylabel(\"Feature 2\")\n",
        "plt.title(\"Expectation-Maximization Algorithm\")\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()"
      ]
    }
