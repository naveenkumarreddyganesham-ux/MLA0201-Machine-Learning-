        "import matplotlib.pyplot as plt\n",
        "from sklearn.linear_model import LinearRegression\n",
        "\n",
        "# Dataset: House size in square feet and price in lakhs\n",
        "X = [[500], [700], [900], [1100], [1300], [1500]]\n",
        "y = [15, 20, 25, 30, 35, 40]\n",
        "\n",
        "# Train the model\n",
        "model = LinearRegression()\n",
        "model.fit(X, y)\n",
        "\n",
        "# Predict house price\n",
        "size = [[1000]]\n",
        "price = model.predict(size)\n",
        "\n",
        "print(\"House Size:\", size[0][0], \"sq.ft\")\n",
        "print(\"Predicted House Price:\", round(price[0], 2), \"lakhs\")\n",
        "\n",
        "# Plot graph\n",
        "plt.scatter(X, y, color=\"blue\", label=\"Actual Prices\")\n",
        "plt.plot(X, model.predict(X), color=\"red\", label=\"Predicted Prices\")\n",
        "\n",
        "plt.xlabel(\"House Size (sq.ft)\")\n",
        "plt.ylabel(\"House Price (Lakhs)\")\n",
        "plt.title(\"House Price Prediction\")\n",
        "plt.legend()\n",
        "plt.show()"
      ]
    }
