      "source": [
        "import matplotlib.pyplot as plt\n",
        "from sklearn.linear_model import LinearRegression\n",
        "\n",
        "# Dataset\n",
        "# Car age in years and price in lakhs\n",
        "X = [[1], [2], [3], [4], [5], [6], [7], [8]]\n",
        "y = [10, 9, 8, 7, 6, 5, 4, 3]\n",
        "\n",
        "# Create and train model\n",
        "model = LinearRegression()\n",
        "model.fit(X, y)\n",
        "\n",
        "# Predict car price\n",
        "age = [[4]]\n",
        "price = model.predict(age)\n",
        "\n",
        "print(\"Car Age:\", age[0][0], \"years\")\n",
        "print(\"Predicted Car Price:\", round(price[0], 2), \"lakhs\")\n",
        "\n",
        "# Plot graph\n",
        "plt.scatter(X, y, color=\"blue\", label=\"Actual Price\")\n",
        "plt.plot(X, model.predict(X), color=\"red\", label=\"Predicted Price\")\n",
        "\n",
        "plt.xlabel(\"Car Age (Years)\")\n",
        "plt.ylabel(\"Car Price (Lakhs)\")\n",
        "plt.title(\"Car Price Prediction using Linear Regression\")\n",
        "plt.legend()\n",
        "plt.show()"
      ]
