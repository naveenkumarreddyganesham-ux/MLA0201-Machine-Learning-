        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.linear_model import LinearRegression\n",
        "from sklearn.preprocessing import PolynomialFeatures\n",
        "from sklearn.metrics import mean_squared_error\n",
        "\n",
        "# Sample dataset\n",
        "X = np.array([1, 2, 3, 4, 5, 6, 7, 8]).reshape(-1, 1)\n",
        "y = np.array([2, 5, 10, 17, 26, 37, 50, 65])\n",
        "\n",
        "# Linear Regression\n",
        "linear_model = LinearRegression()\n",
        "linear_model.fit(X, y)\n",
        "y_linear = linear_model.predict(X)\n",
        "\n",
        "# Polynomial Regression\n",
        "poly = PolynomialFeatures(degree=2)\n",
        "X_poly = poly.fit_transform(X)\n",
        "\n",
        "poly_model = LinearRegression()\n",
        "poly_model.fit(X_poly, y)\n",
        "y_poly = poly_model.predict(X_poly)\n",
        "\n",
        "# Compare results\n",
        "print(\"Linear Regression MSE:\",\n",
        "      mean_squared_error(y, y_linear))\n",
        "\n",
        "print(\"Polynomial Regression MSE:\",\n",
        "      mean_squared_error(y, y_poly))\n",
        "\n",
        "# Plot results\n",
        "plt.scatter(X, y, color=\"blue\", label=\"Actual Data\")\n",
        "plt.plot(X, y_linear, color=\"red\",\n",
        "         label=\"Linear Regression\")\n",
        "plt.plot(X, y_poly, color=\"green\",\n",
        "         label=\"Polynomial Regression\")\n",
        "\n",
        "plt.xlabel(\"X Values\")\n",
        "plt.ylabel(\"Y Values\")\n",
        "plt.title(\"Linear vs Polynomial Regression\")\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()"
      ]
